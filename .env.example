# keybackcon — variables de entorno de configuración
#
# Referencia de las variables que leen el CLI (Rust) y la mesa de luz (GUI GTK4).
# Este fichero NO se carga automáticamente: la CLI no usa dotenv (ADR 2, cero
# dependencias). Sirve como documentación y plantilla para un cargador externo.

# ── Ubicaciones XDG ──────────────────────────────────────────────────────
# Compartidas con el resto del sistema; defínelas solo si quieres mover dónde
# viven el estado, la configuración o la caché de keybackcon.

# Estado persistente (preferencias + modo). Si no se define, ~/.local/state
# (se exige HOME absoluto). Ruta resultante: $XDG_STATE_HOME/keybackcon/state
#XDG_STATE_HOME=~/.local/state

# Configuración de la GUI. Si no se define, ~/.config
#XDG_CONFIG_HOME=~/.config

# Caché de la GUI (bandeja). Si no se define, ~/.cache
#XDG_CACHE_HOME=~/.cache

# Directorio runtime (candado de escritura única y pidfile de animación).
# Si no se define, /tmp/keybackcon-$UID.
#XDG_RUNTIME_DIR=/run/user/1000

# ── Instalación (scripts/install.sh) ────────────────────────────────────
# Omite la regla udev y la creación del grupo/candado de escritura.
# Útil en contenedores o hosts sin systemd-udev.
#KEYBACKCON_SKIP_UDEV=1

# Reactiva la unidad systemd del usuario al reinstalar aunque ya existiera
# (por defecto se conserva el estado enabled/disabled previo).
#KEYBACKCON_ENABLE_RESTORE=1

# ── Solo desarrollo/tests (no definir en uso normal) ────────────────────
# Ruta absoluta del candado del escritor HID; los tests la sustituyen por
# un directorio temporal. No definir fuera de los tests.
#KEYBACKCON_WRITER_LOCK=

# Marca interna del subproceso que posee el candado (la fija el propio CLI).
#KEYBACKCON_LOCK_CHILD=

# Guard de los tests de ventana de la GUI (requiere display GTK/Adwaita).
#KEYBACKCON_GUI_TESTS=1

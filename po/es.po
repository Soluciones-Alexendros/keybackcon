#: gui/window.py:1141
msgid ""
"Could not talk to the keyboard. It is usually a system permission and one "
"click fixes it."
msgstr ""
"No se pudo hablar con el teclado. Suele ser un permiso del sistema y se "
"arregla con un clic."

#: gui/window.py:1143
msgid ""
"Could not talk to the keyboard. Install it by hand and retry: install -m644 "
"~/.local/share/keybackcon/70-keybackcon.rules /etc/udev/rules.d/70-"
"keybackcon.rules && sudo udevadm control --reload && sudo udevadm trigger --"
"subsystem-match=hidraw"
msgstr ""
"No se pudo hablar con el teclado. Instálalo a mano y reintenta: install "
"-m644 ~/.local/share/keybackcon/70-keybackcon.rules /etc/udev/rules.d/70-"
"keybackcon.rules && sudo udevadm control --reload && sudo udevadm trigger --"
"subsystem-match=hidraw"

#: gui/window.py:1145
msgid "No keyboard access"
msgstr "Sin acceso al teclado"

#: gui/window.py:1151
msgid "Install permission"
msgstr "Instalar permiso"

#: gui/window.py:1152
msgid "Retry"
msgstr "Reintentar"

#: gui/window.py:1188
msgid "Permission not installed (pkexec cancelled or not authorized)."
msgstr "Permiso no instalado (pkexec cancelado o sin autorización)."

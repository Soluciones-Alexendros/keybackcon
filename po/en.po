#: gui/window.py:1143
msgid ""
"Could not talk to the keyboard. Install it by hand and retry: install -m644 "
"~/.local/share/keybackcon/70-keybackcon.rules /etc/udev/rules.d/70-"
"keybackcon.rules && sudo udevadm control --reload && sudo udevadm trigger --"
"subsystem-match=hidraw"
msgstr ""
"Could not talk to the keyboard. Install it by hand and retry: install -m644 "
"~/.local/share/keybackcon/70-keybackcon.rules /etc/udev/rules.d/70-"
"keybackcon.rules && sudo udevadm control --reload && sudo udevadm trigger --"
"subsystem-match=hidraw"


# Maintainer: Alexendros <operaciones@alexendros.dev>
# shellcheck shell=bash
# shellcheck disable=SC2034,SC2154
pkgname=keybackcon
pkgver=2.4.1
pkgrel=1
pkgdesc="Control RGB del teclado AERO X16 vía HID LampArray"
arch=('x86_64')
url="https://github.com/Soluciones-Alexendros/keybackcon"
license=('MIT')
depends=()
optdepends=('python-gobject: panel gráfico keybackcon-gui' 'gtk4: panel gráfico keybackcon-gui' 'libadwaita: panel gráfico keybackcon-gui' 'libayatana-appindicator: indicador de bandeja para keybackcon-gui' 'python-cairo: indicador de bandeja para keybackcon-gui')
makedepends=('cargo' 'gettext')
conflicts=('kbd-rgb')
replaces=('kbd-rgb')
# No anunciar AUR hasta checksum real + .SRCINFO + chroot (ver docs/compatibility/matriz.md).
# Sustituir SKIP con `updpkgsums` antes de publicar.
sha256sums=('SKIP')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")

build() {
  cd "${pkgname}-${pkgver}" || return 1
  cargo build --release --locked
  for po in po/*.po; do
    lang="${po##*/}"; lang="${lang%.po}"
    mkdir -p "gui/locale/${lang}/LC_MESSAGES"
    msgfmt -o "gui/locale/${lang}/LC_MESSAGES/keybackcon.mo" "${po}"
  done
}

package() {
  cd "${pkgname}-${pkgver}" || return 1
  install -Dm755 target/release/keybackcon "${pkgdir}/usr/bin/keybackcon"
  install -Dm755 packaging/keybackcon-gui "${pkgdir}/usr/bin/keybackcon-gui"
  install -Dm644 gui/*.py "${pkgdir}/usr/share/keybackcon/gui/"
  install -Dm644 packaging/desktop/keybackcon.desktop "${pkgdir}/usr/share/applications/keybackcon.desktop"
  install -Dm644 assets/icons/keybackcon.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/keybackcon.svg"
  install -Dm644 packaging/udev/70-keybackcon.rules "${pkgdir}/usr/lib/udev/rules.d/70-keybackcon.rules"
  install -Dm644 packaging/systemd/keybackcon.service "${pkgdir}/usr/lib/systemd/user/keybackcon.service"
  install -Dm644 packaging/systemd/keybackcon-animation@.service "${pkgdir}/usr/lib/systemd/user/keybackcon-animation@.service"
  for mo in gui/locale/*/LC_MESSAGES/keybackcon.mo; do
    lang="${mo#gui/locale/}"; lang="${lang%%/*}"
    install -Dm644 "${mo}" "${pkgdir}/usr/share/locale/${lang}/LC_MESSAGES/keybackcon.mo"
  done
  install -Dm644 gui/org.iniciativas.keybackcon.gschema.xml "${pkgdir}/usr/share/glib-2.0/schemas/org.iniciativas.keybackcon.gschema.xml"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

#!/bin/sh
set -e

# Instalar ≠ autorizar: este postinst crea grupo y candado, pero no añade
# usuarios al grupo ilutex. La habilitación es explícita (usermod + nueva sesión).

writer_ok=1
if command -v systemd-sysusers >/dev/null 2>&1; then
  if ! systemd-sysusers ilutex.conf; then
    echo "ilutex: aviso: systemd-sysusers ilutex.conf falló" >&2
    writer_ok=0
  fi
else
  echo "ilutex: aviso: systemd-sysusers no disponible" >&2
  writer_ok=0
fi
if command -v systemd-tmpfiles >/dev/null 2>&1; then
  if ! systemd-tmpfiles --create ilutex.conf; then
    echo "ilutex: aviso: systemd-tmpfiles --create ilutex.conf falló" >&2
    writer_ok=0
  fi
else
  echo "ilutex: aviso: systemd-tmpfiles no disponible" >&2
  writer_ok=0
fi
if [ ! -d /run/ilutex ] || [ ! -e /run/ilutex/writer.lock ]; then
  echo "ilutex: aviso: falta /run/ilutex/writer.lock tras la instalación" >&2
  writer_ok=0
fi
if [ "$writer_ok" = 1 ]; then
  echo "ilutex: candado /run/ilutex/writer.lock listo (root:ilutex)."
  echo "ilutex: para escribir, añade tu usuario al grupo: sudo usermod -aG ilutex \"\$USER\""
  echo "ilutex: y abre una sesión nueva (o newgrp ilutex)."
fi

if [ -x /usr/bin/udevadm ]; then
  /usr/bin/udevadm control --reload-rules || true
  /usr/bin/udevadm trigger --subsystem-match=hidraw || true
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl --global daemon-reload || true
fi

exit 0
{
  "name": "keybackcon",
  "version": "2.3.0",
  "description": "Keyboard Backlight Controls — control RGB del teclado AERO X16 vía HID LampArray, sin dependencias (binario precompilado + instalación automática de servicios)",
  "license": "MIT",
  "type": "commonjs",
  "repository": "Soluciones-Alexendros/keybackcon",
  "homepage": "https://github.com/Soluciones-Alexendros/keybackcon#readme",
  "keywords": [
    "keyboard",
    "rgb",
    "hid",
    "lamparray",
    "backlight",
    "aero-x16"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "keybackcon": "bin/keybackcon.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "optionalDependencies": {
    "keybackcon-linux-x64": "2.3.0",
    "keybackcon-linux-arm64": "2.3.0"
  },
  "files": [
    "bin/keybackcon.js",
    "install.js",
    "udev/70-keybackcon.rules",
    "tmpfiles.d/keybackcon.conf",
    "sysusers.d/keybackcon.conf",
    "systemd/keybackcon.service",
    "systemd/keybackcon-animation@.service",
    "README.md"
  ]
}

{
  "name": "ilutex",
  "version": "2.5.0",
  "description": "iLutex — control cromático del teclado AERO X16 vía HID LampArray, sin dependencias (binario precompilado + instalación automática de servicios)",
  "license": "MIT",
  "type": "commonjs",
  "repository": "Soluciones-Alexendros/keybackcon",
  "homepage": "https://github.com/Soluciones-Alexendros/keybackcon#readme",
  "keywords": [
    "keyboard",
    "rgb",
    "hid",
    "lamparray",
    "backlight",
    "lutex",
    "aero-x16"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ilutex": "bin/ilutex.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "optionalDependencies": {
    "ilutex-linux-x64": "2.5.0",
    "ilutex-linux-arm64": "2.5.0"
  },
  "files": [
    "bin/ilutex.js",
    "install.js",
    "udev/70-ilutex.rules",
    "tmpfiles.d/ilutex.conf",
    "sysusers.d/ilutex.conf",
    "systemd/ilutex.service",
    "systemd/ilutex-animation@.service",
    "README.md"
  ]
}
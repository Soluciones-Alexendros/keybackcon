[Unit]
Description=iLutex — restaura el color al iniciar sesión
# Tras la sesión gráfica; evita After=default.target + WantedBy=default.target.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
# --on-login respeta restore_policy=never del estado persistido.
ExecStart=__KEYBACKCON_BIN__ restore --on-login
RemainAfterExit=yes
# Al iniciar sesión las ACL uaccess pueden no estar aplicadas todavía.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target